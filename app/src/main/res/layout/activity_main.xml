<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">




    <FrameLayout
        android:id="@+id/videoContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextureView
                android:id="@+id/remote"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

<!--            For remote camera off-->
            <FrameLayout
                android:id="@+id/remoteCameraOffView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#202124"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:src="@drawable/user"
                        android:scaleType="centerCrop"
                        android:contentDescription="User" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Camera off"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp" />

                </LinearLayout>

            </FrameLayout>

        </FrameLayout>

        <FrameLayout
            android:id="@+id/localVideoContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextureView
                android:id="@+id/frame"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <View
                android:id="@+id/blackCameraView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#000000"
                android:visibility="gone" />

        </FrameLayout>

    </FrameLayout>

    <ImageButton
        android:id="@+id/switchCamera"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="60dp"
        android:src="@drawable/camera_switch"
        android:scaleType="fitCenter"
        android:padding="3dp"
        android:background="@drawable/call_background"
        android:layout_marginEnd="15dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:ignore="MissingConstraints" />


   <LinearLayout
       android:id="@+id/buttoncontrol"
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
       tools:ignore="MissingConstraints"
       android:gravity="center_horizontal"
       app:layout_constraintBottom_toBottomOf="parent"
       app:layout_constraintStart_toStartOf="parent"
       app:layout_constraintEnd_toEndOf="parent"
       >

       <ImageButton
           android:id="@+id/cameraButton"
           android:layout_width="70dp"
           android:layout_height="70dp"
           android:layout_marginStart="24dp"
           android:layout_marginBottom="60dp"
           android:src="@drawable/ic_camera"
           android:scaleType="fitCenter"
           android:padding="3dp"
           android:background="@drawable/call_background"
           android:contentDescription="camera"
           app:layout_constraintBottom_toBottomOf="parent"
           app:layout_constraintStart_toStartOf="parent" />


       <ImageButton
           android:id="@+id/callendButton"
           android:layout_width="70dp"
           android:layout_height="70dp"
           android:layout_marginStart="24dp"
           android:layout_marginBottom="60dp"
           android:src="@drawable/call_end"
           android:scaleType="fitCenter"
           android:padding="3dp"
           android:background="@drawable/call_background"
           android:contentDescription="Call_End"
           app:layout_constraintBottom_toBottomOf="parent"
           app:layout_constraintStart_toStartOf="parent" />


       <ImageButton
           android:id="@+id/muteButton"
           android:layout_width="70dp"
           android:layout_height="70dp"
           android:layout_marginStart="24dp"
           android:layout_marginBottom="60dp"
           android:src="@drawable/ic_mic"
           android:scaleType="fitCenter"
           android:padding="3dp"
           android:background="@drawable/call_background"
           android:contentDescription="Mute microphone"
           app:layout_constraintBottom_toBottomOf="parent"
           app:layout_constraintStart_toStartOf="parent" />



   </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>